{
  "$schema": "../../../schema/muck.schema.json",
  "id": "com.muckstore.quick-notes",
  "name": "Quick Notes",
  "version": "1.0.0",
  "license": "MIT",
  "summary": "A portable notes pad that stores text next to the program and reads Muck settings as JSON.",
  "description": "Official sample. Written as a normal Windows PowerShell script — no Muck SDK. Settings arrive via MUCK_SETTINGS_PATH.",
  "categories": ["productivity"],
  "tags": ["notes", "official", "sample"],
  "source": {
    "github": "muckstore/quick-notes"
  },
  "entry": "notes.ps1",
  "install": {
    "kind": "portable",
    "shortcuts": {
      "startMenu": true,
      "desktop": false
    }
  },
  "permissions": ["filesystem", "autostart"],
  "settings": {
    "schema": {
      "type": "object",
      "title": "Quick Notes",
      "properties": {
        "fontSize": {
          "type": "number",
          "title": "Font size",
          "minimum": 10,
          "maximum": 28,
          "default": 14,
          "x-muck-widget": "slider"
        },
        "theme": {
          "type": "string",
          "title": "Editor theme",
          "enum": ["dark", "light"],
          "default": "dark",
          "x-muck-widget": "select"
        },
        "autosave": {
          "type": "boolean",
          "title": "Autosave",
          "default": true,
          "x-muck-widget": "toggle"
        }
      }
    }
  },
  "watchdog": {
    "onCrash": "notify",
    "maxRestarts": 2
  },
  "update": {
    "channel": "github-releases"
  },
  "i18n": {
    "tr": {
      "name": "Hızlı Notlar",
      "summary": "Muck ayarlarını JSON olarak okuyan taşınabilir bir not defteri."
    }
  },
  "ui": {
    "accent": "#d4a056"
  }
}
